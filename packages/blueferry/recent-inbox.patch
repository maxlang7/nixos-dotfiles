diff --git a/src/blueferry/recent_history.py b/src/blueferry/recent_history.py
new file mode 100644
index 0000000..bf4c829
--- /dev/null
+++ b/src/blueferry/recent_history.py
@@ -0,0 +1,43 @@
+"""Convert bounded MAP inbox summaries into retained conversation events."""
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from datetime import datetime
+from typing import Any
+
+from blueferry.events import SmsEvent
+
+
+def inbox_events(
+    messages: Sequence[Mapping[str, Any]], contacts,
+) -> list[SmsEvent]:
+    """Build history records from MAP's recent inbox without dispatching them.
+
+    This is an initial-history import, not a new-message notification path:
+    old one-time codes must never be copied and historical messages must not
+    generate desktop notifications.
+    """
+    events: list[SmsEvent] = []
+    for message in messages:
+        handle = str(message.get("handle") or "").strip()
+        if not handle:
+            continue
+        raw_timestamp = str(message.get("timestamp") or "")
+        try:
+            timestamp = datetime.fromisoformat(raw_timestamp) if raw_timestamp else None
+        except (ValueError, OverflowError):
+            timestamp = None
+        sender = str(message.get("sender") or "").strip() or None
+        normalized = str(message.get("sender_phone_norm") or "").strip() or None
+        events.append(SmsEvent(
+            kind="sms_received",
+            handle=handle,
+            sender_address=sender,
+            sender_phone_norm=normalized,
+            contact_name=contacts.resolve(sender or normalized),
+            body=str(message.get("body") or ""),
+            timestamp=timestamp,
+            is_read=bool(message.get("read", True)),
+            message_path=None,
+        ))
+    return events
diff --git a/tests/test_recent_history.py b/tests/test_recent_history.py
new file mode 100644
index 0000000..da3e49d
--- /dev/null
+++ b/tests/test_recent_history.py
@@ -0,0 +1,164 @@
+from datetime import datetime
+
+from blueferry.recent_history import inbox_events
+from blueferry.threads import build_threads
+
+
+class Contacts:
+    def resolve(self, address):
+        return "Contact" if address else None
+
+
+def test_inbox_events_keep_recent_messages_without_notification_metadata():
+    events = inbox_events([{
+        "handle": "message123",
+        "sender": "+1 555 123 4567",
+        "sender_phone_norm": "15551234567",
+        "body": "hello",
+        "timestamp": "2026-10-12T01:00:00-04:00",
+        "read": False,
+    }], Contacts())
+
+    assert len(events) == 1
+    event = events[0]
+    assert event.kind == "sms_received"
+    assert event.handle == "message123"
+    assert event.contact_name == "Contact"
+    assert event.body == "hello"
+    assert event.timestamp == datetime.fromisoformat("2026-10-12T01:00:00-04:00")
+    assert event.message_path is None
+    assert event.is_read is False
+
+
+def test_inbox_events_skip_missing_handles_and_tolerate_bad_timestamps():
+    events = inbox_events([
+        {"sender": "no handle"},
+        {"handle": "message456", "timestamp": "invalid"},
+    ], Contacts())
+
+    assert len(events) == 1
+    assert events[0].timestamp is None
+    assert events[0].is_read is True
+
+
+def test_recent_inbox_events_populate_conversation_projection():
+    events = inbox_events([{
+        "handle": "message789",
+        "sender": "+1 555 123 4567",
+        "sender_phone_norm": "15551234567",
+        "body": "recent",
+        "timestamp": "2026-10-12T01:00:00-04:00",
+    }], Contacts())
+
+    threads = build_threads([event.to_dict() for event in events], Contacts())
+
+    assert len(threads) == 1
+    assert threads[0]["messages"][0]["body"] == "recent"
+
+
+def bootstrap(monkeypatch):
+    from types import SimpleNamespace
+
+    from blueferry import daemon
+
+    value = object.__new__(daemon.Daemon)
+    value.sessions = SimpleNamespace(map=SimpleNamespace(path="/session"))
+    value.storage = SimpleNamespace(revision=0, status=SimpleNamespace(can_write=True))
+    value.contacts = Contacts()
+    value._recent_history_seed_pending = False
+    notifications = []
+    value._dbus_service = SimpleNamespace(
+        operations=SimpleNamespace(invalidate_conversations=lambda: notifications.append("invalidate")),
+        emit_history_changed=lambda: notifications.append("history"),
+    )
+    callbacks = {}
+    value.obex_worker = SimpleNamespace(submit=lambda work, **kwargs: callbacks.update(kwargs))
+    records = []
+    monkeypatch.setattr(daemon, "read_events", lambda **kwargs: list(records))
+    monkeypatch.setattr(daemon, "append_events", lambda events, **kwargs: records.extend(events))
+    return value, callbacks, records, notifications
+
+
+def test_bootstrap_updates_gtk_projection_and_deduplicates_live_arrivals(monkeypatch):
+    value, callbacks, records, notifications = bootstrap(monkeypatch)
+    value._seed_recent_inbox()
+    value._seed_recent_inbox()
+    assert value._recent_history_seed_pending
+    # A push can arrive while the bounded inbox query is in flight.
+    records.append({"handle": "message1"})
+    callbacks["on_success"]([
+        {"handle": "message1", "sender": "15551234567"},
+        {"handle": "message2", "sender": "15551234567", "body": "recent"},
+        {"handle": "message2", "sender": "15551234567"},
+    ])
+    assert [row["handle"] for row in records] == ["message1", "message2"]
+    assert notifications == ["invalidate", "history"]
+    assert not value._recent_history_seed_pending
+
+
+def test_bootstrap_discards_results_after_storage_policy_changes(monkeypatch):
+    value, callbacks, records, notifications = bootstrap(monkeypatch)
+    value._seed_recent_inbox()
+    value.storage.revision += 1
+    callbacks["on_success"]([{"handle": "message1"}])
+    assert records == notifications == []
+    assert not value._recent_history_seed_pending
+
+
+def test_bootstrap_discards_replaced_phone_session(monkeypatch):
+    value, callbacks, records, notifications = bootstrap(monkeypatch)
+    value._seed_recent_inbox()
+    value.sessions.map = None
+    callbacks["on_success"]([{"handle": "message1"}])
+    assert records == notifications == []
+
+
+def test_bootstrap_write_failure_allows_retry(monkeypatch):
+    from blueferry import daemon
+
+    value, callbacks, _records, notifications = bootstrap(monkeypatch)
+    value._seed_recent_inbox()
+
+    def fail(*args, **kwargs):
+        raise OSError("disk full")
+    monkeypatch.setattr(daemon, "append_events", fail)
+    callbacks["on_success"]([{"handle": "message1"}])
+    assert not value._recent_history_seed_pending
+    assert notifications == []
+
+
+def test_reconnect_catches_up_existing_history_without_duplicates(monkeypatch):
+    value, callbacks, records, notifications = bootstrap(monkeypatch)
+    records.append({"handle": "old"})
+    value._seed_recent_inbox()
+    callbacks["on_success"]([{"handle": "old"}, {"handle": "offline"}])
+    assert [row["handle"] for row in records] == ["old", "offline"]
+    assert notifications == ["invalidate", "history"]
+    notifications.clear()
+    value._seed_recent_inbox()
+    callbacks["on_success"]([{"handle": "old"}, {"handle": "offline"}])
+    assert [row["handle"] for row in records] == ["old", "offline"]
+    assert notifications == []
+
+
+
+def test_import_batch_rolls_back_if_any_record_cannot_be_stored(monkeypatch, tmp_path):
+    import pytest
+
+    from blueferry import history
+
+    path = tmp_path / "events.sqlite"
+    insert = history._insert
+
+    def fail_second(database, event, storage):
+        if event["handle"] == "second":
+            raise OSError("storage failure")
+        insert(database, event, storage)
+
+    monkeypatch.setattr(history, "_insert", fail_second)
+    with pytest.raises(OSError, match="storage failure"):
+        history.append_events([
+            {"kind": "sms_received", "handle": "first"},
+            {"kind": "sms_received", "handle": "second"},
+        ], path=path)
+    assert history.read_events(path=path) == []
