+    def _seed_recent_inbox(self) -> None:
+        """Catch up the bounded recent inbox whenever MAP becomes available."""
+        session = self.sessions.map
+        if session is None or not getattr(session, "path", None):
+            return
+        if (
+            self._recent_history_seed_pending
+            or not self.storage.status.can_write
+        ):
+            return
+        self._recent_history_seed_pending = True
+        storage_revision = self.storage.revision
+
+        def imported(messages: list[dict]) -> None:
+            self._recent_history_seed_pending = False
+            if (
+                self.sessions.map is not session
+                or self.storage.revision != storage_revision
+                or not self.storage.status.can_write
+            ):
+                return
+            existing = {
+                str(event.get("handle") or "")
+                for event in read_events(
+                    kinds={"sms_received", "sms_sent"}, limit=500,
+                    storage=self.storage,
+                )
+            }
+            events = inbox_events(messages, self.contacts)
+            imported_events = []
+            for event in events:
+                if event.handle in existing:
+                    continue
+                imported_events.append(event.to_dict())
+                existing.add(event.handle)
+            append_events(imported_events, storage=self.storage)
+            added = len(imported_events)
+            if added:
+                log.info("imported %d recent inbox messages into local conversations", added)
+                if self._dbus_service is not None:
+                    self._dbus_service.operations.invalidate_conversations()
+                    self._dbus_service.emit_history_changed()
+
+        def failed(error: Exception) -> None:
+            self._recent_history_seed_pending = False
+            log.info("could not import recent inbox messages (%s)", type(error).__name__)
+
+        def complete(messages: list[dict]) -> None:
+            try:
+                imported(messages)
+            except Exception as error:
+                failed(error)
+
+        try:
+            self.obex_worker.submit(
+                lambda: list_recent_messages(session.path, limit=20),
+                on_success=complete,
+                on_error=failed,
+            )
+        except Exception as error:
+            failed(error)
 
     def _mns_present(self) -> None:
         self._mns_reconnect_spent = False
