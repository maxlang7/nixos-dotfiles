+export function nextSelectableModel(
+  options: ReadonlyArray<AppModelOption>,
+  currentModel: string,
+  disabledReason: (model: string) => string | null,
+): AppModelOption | null {
+  const available = options.filter(
+    (option) => !option.isUnavailable && disabledReason(option.slug) === null,
+  );
+  if (available.length < 2) return null;
+  const index = available.findIndex((option) => option.slug === currentModel);
+  return available[(index + 1) % available.length] ?? null;
+}
