// -*- mode: json -*-

{
  "layer": "top",
  "position": "top",
  "height": 31,
  "spacing": 0,
  "modules-left": [
    "custom/powerbutton",
    "hyprland/workspaces",
    "custom/nixos-rebuild",
    "custom/hypridle",
    "custom/wlsunset",
    "custom/notifications",
    // "custom/tree",
    // "custom/nixos",
    // "custom/timer",
    "custom/codex-usage",
    "custom/capture",
    "custom/wacom-pointer"
    // "mpris"
  ],
  "modules-center": ["clock#2", "clock#1", "clock#3", "custom/run-streak"],
  "modules-right": [
    "custom/network",
    "custom/bluetooth",
    "pulseaudio",
    "cpu",
    "custom/battery"
  ],
  "custom/powerbutton": {
    "format": "<span size='105%'>󰐥</span>",
    "tooltip": true,
    "tooltip-format": "Session and power",
    "on-click": "popup-launch power 700 520 audio-select power"
  },
  "custom/nixos-rebuild": {
    "exec": "/etc/nixos/artifacts/scripts/nixos-rebuild-waybar.sh watch",
    "return-type": "json",
    "restart-interval": 2,
    "exec-on-event": false,
    "format": "<span size='120%'>{}</span>",
    "tooltip": true,
    "on-click": "/etc/nixos/artifacts/scripts/nixos-rebuild-waybar.sh start",
    "on-click-right": "/etc/nixos/artifacts/scripts/nixos-rebuild-waybar.sh update"
  },
  "custom/capture": {
    "format": "<span size='132%' rise='-2pt'>󰑋</span>",
    "tooltip": true,
    "tooltip-format": "Record screen, window, microphone, or application audio",
    "on-click": "popup-launch recorder 1000 700 capture-select"
  },
  // "custom/tree": {
  //    "format": "󰐅",
  // 	"on-click": "ghostty -e cbonsai -l -m '\"I am at home among the trees\" - J.R.R Tolkien'"
  // },
  // "custom/timer": {
  //   "format": "{}",
  //   "tooltip": false,
  //   "return-type": "json",
  //   "interval": 10,
  //   "on-click": "uairctl toggle",
  //   "on-click-middle": "uairctl prev",
  //   "on-click-right": "uairctl next",
  //   "exec-if": "which uairctl",
  //   "exec": "uairctl fetch '{\"text\":\"{time}\",\"class\":\"{state}\",\"percentage\":{percent}}'"
  // },
  "custom/codex-usage": {
    "exec": "/etc/nixos/artifacts/scripts/codex-usage.sh",
    "return-type": "json",
    "escape": false,
    "interval": 60,
    "signal": 10,
    "tooltip": true,
    "on-click": "pkill -SIGRTMIN+10 waybar",
    "on-click-right": "ghostty -e codex"
  },
  "custom/wacom-pointer": {
    "exec": "/etc/nixos/artifacts/scripts/wacom-pointer-toggle.sh status",
    "on-click": "/etc/nixos/artifacts/scripts/wacom-pointer-toggle.sh toggle",
    "return-type": "json",
    "format": "<span size='105%'>{}</span>",
    "interval": 1,
    "signal": 12,
    "tooltip": true
  },
  "custom/hypridle": {
    "exec": "/etc/nixos/artifacts/scripts/hypridle-toggle.sh",
    "on-click": "/etc/nixos/artifacts/scripts/hypridle-toggle.sh toggle && pkill -SIGRTMIN+9 waybar",
    "interval": 10,
    "signal": 9,
    "format": "<span size='116%' rise='-2pt'>{}</span>",
    "return-type": "json",
    "tooltip": true
  },
  "custom/wlsunset": {
    "exec": "/etc/nixos/artifacts/scripts/wlsunset-toggle.sh",
    "on-click": "/etc/nixos/artifacts/scripts/wlsunset-toggle.sh toggle && pkill -SIGRTMIN+13 waybar",
    "interval": 10,
    "signal": 13,
    "format": "<span size='132%' rise='-0.5pt'>{}</span>",
    "return-type": "json",
    "tooltip": true
  },
  "custom/notifications": {
    "exec": "/etc/nixos/artifacts/scripts/notification-toggle.sh",
    "on-click": "/etc/nixos/artifacts/scripts/notification-toggle.sh toggle && pkill -SIGRTMIN+11 waybar",
    "on-click-right": "/etc/nixos/artifacts/scripts/notification-toggle.sh history",
    "interval": 5,
    "signal": 11,
    "format": "<span size='165%' rise='-0.5pt'>{}</span>",
    "return-type": "json",
    "tooltip": true
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "format": "{name}"
  },
  "custom/resolution": {
    "format": "{}",
    "exec": "/usr/bin/env bash ~/.config/waybar/get_monitor_resolution_icon.sh",
    "on-click": "bash /etc/nixos/artifacts/scripts/rofi-resolution-switcher.sh",
    "interval": 30
  },
  // "mpris": {
  //   "format": "{player_icon} <i>{title}</i>",
  //   "format-paused": "{status_icon} <i>{title}</i>",
  //   "max-length": 50,
  //   "ignored-players": ["brave"],
  //   "player-icons": {
  //     "default": "▶",
  //     "mpv": "🎵"
  //   },
  //   "status-icons": {
  //     "paused": "⏸"
  //   }
  // },
  "clock#1": {
    "format": "{:%a}",
    "tooltip": false
  },
  "clock#2": {
    "format": "{:%r}",
    "tooltip": false,
    "interval": 1
  },
  "clock#3": {
    "format": "{:%m/%d}",
    "tooltip": false
  },
  "custom/run-streak": {
    "format": "<span size='90%' rise='0.5pt'>🔥</span>{}",
    "exec": "echo $(( ( $(date +%s) - $(date -d 'Aug 3, 2025 00:00:00' +%s) ) / 86400 ))",
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "Run streak length (Started Aug 3, 2025)"
  },
  "custom/network": {
    "exec": "python3 /etc/nixos/artifacts/scripts/waybar-network.py",
    "return-type": "json",
    "interval": 5,
    "escape": false,
    "tooltip": true,
    "on-click": "popup-launch network 1100 700 audio-select network",
    "on-click-right": "popup-launch network 1100 700 audio-select network",
    "on-click-middle": "bash /etc/nixos/artifacts/scripts/switch-connections.sh"
  },

  "custom/bluetooth": {
    "exec": "waybar-bluetooth",
    "return-type": "json",
    "interval": 3,
    "format": "{}",
    "on-click": "popup-launch bluetooth 900 650 audio-select bluetooth"
  },
  "pulseaudio": {
    //"scroll-step": 1,
    "format": "{icon} <span rise='1.5pt'>{volume}%</span>",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "<span size='150%' rise='-0.5pt'></span>",
    "format-icons": {
      "headphone": "<span size='100%' rise='-0.5pt'></span>",
      "headphones": "<span size='100%' rise='-0.5pt'></span>",
      "hands-free": "<span size='75%' rise='-0.5pt'></span>",
      "handsfree": "<span size='75%' rise='-0.5pt'></span>",
      "headset": "<span size='75%' rise='-0.5pt'></span>",
      "phone": "<span size='150%' rise='-0.5pt'></span>",
      "portable": "<span size='150%' rise='-0.5pt'></span>",
      "car": "<span size='150%' rise='-0.5pt'></span>",
      "default": ["<span size='150%' rise='-0.5pt'></span>", "<span size='150%' rise='-0.5pt'></span>"]
    },
    "on-click": "popup-launch audio 1000 700 audio-select audio",
    "on-click-right": "popup-launch audio 1000 700 audio-select audio"
  },
  "cpu": {
    "interval": 5,
    "format": "CPU {usage}%",
    "on-click": "popup-launch btop 1200 760 btop",
    "on-click-right": "popup-launch htop 1200 760 htop"
  },
  "custom/battery": {
    "exec": "/etc/nixos/artifacts/scripts/battery-info.sh",
    "return-type": "json",
    "escape": false,
    "interval": 5,
    "format": "{}",
    "tooltip": true,
    "on-click": "popup-launch btop 1200 760 btop",
    "on-click-right": "popup-launch htop 1200 760 htop"
  }
}
